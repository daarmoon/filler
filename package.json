{
  "name": "hardfiller-maker",
  "productName": "하드필러 메이커",
  "version": "7.0.0",
  "description": "홈쇼핑 하드필러·오프닝필러·인서트·통강조 영상을 스토리보드로 만드는 도구 (윈도우 앱 / 브라우저)",
  "main": "electron/main.js",
  "author": "hardfiller-maker",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/build.js && electron .",
    "ffmpeg:win": "node scripts/fetch-ffmpeg.js win32-x64",
    "dist:win": "node scripts/build.js && node scripts/fetch-ffmpeg.js win32-x64 && electron-builder --win --x64 --publish never",
    "test": "node test/ui8.js && node test/ui7.js && node test/ui6.js && node test/insert.js && node test/tong.js",
    "dist:win:noinstaller": "node scripts/build.js && node scripts/fetch-ffmpeg.js win32-x64 && electron-builder --win portable zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "kr.hardfiller.maker",
    "productName": "하드필러 메이커",
    "artifactName": "HardfillerMaker-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/hardfiller-maker.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "vendor/ffmpeg/win32-x64",
          "to": "ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "하드필러 메이커",
      "artifactName": "HardfillerMaker-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1042"
    },
    "portable": {
      "artifactName": "HardfillerMaker-Portable-${version}.${ext}"
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daarmoon/filler.git"
  }
}
